# Copy to .env and fill in. Never commit .env.

# WellaHealth
WELLAHEALTH_BASE_URL=https://api.wellahealth.com
WELLAHEALTH_CLIENT_ID=
WELLAHEALTH_CLIENT_SECRET=

# Paystack
PAYSTACK_SECRET_KEY=
# Usually the same secret key. Configure this in Paystack's webhook settings
# when the public domain is live: https://YOUR_DOMAIN/payment/webhook
PAYSTACK_WEBHOOK_SECRET=

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=12h

# First admin account (created automatically the first time you run `npm run seed`)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_this_password
SEED_ADMIN_NAME=Admin

# Server
PORT=4000
NODE_ENV=production
ALLOWED_ORIGINS=
# The public base URL this server is reachable at — used to build the Paystack
# payment callback URL. Set this once you have a real domain or ngrok URL;
# leave blank for local-only testing (it'll fall back to the request's own host).
APP_BASE_URL=

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=sehanet

# Token for the read-only WellaHealth reconciliation dashboard
WELLAHEALTH_DASHBOARD_TOKEN=your_secure_token_here
